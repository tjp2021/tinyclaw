{
  "name": "tinyclaw",
  "version": "0.0.5",
  "description": "Multi-agent, multi-team, multi-channel 24/7 AI assistant",
  "scripts": {
    "build": "tsc && tsc -p tsconfig.visualizer.json && echo '{\"type\":\"module\"}' > dist/visualizer/package.json",
    "build:main": "tsc",
    "build:visualizer": "tsc -p tsconfig.visualizer.json && echo '{\"type\":\"module\"}' > dist/visualizer/package.json",
    "whatsapp": "node dist/channels/whatsapp-client.js",
    "discord": "node dist/channels/discord-client.js",
    "telegram": "node dist/channels/telegram-client.js",
    "queue": "node dist/queue-processor.js",
    "visualize": "node dist/visualizer/team-visualizer.js",
    "test": "npx ts-node tests/memory.test.ts",
    "test:live": "npx ts-node tests/memory-live.test.ts",
    "test:approval": "npx ts-node tests/approval.test.ts",
    "test:routing": "npx ts-node tests/routing.test.ts",
    "test:queue": "npx ts-node tests/queue.test.ts",
    "test:all": "npm run test && npm run test:approval && npm run test:routing && npm run test:queue"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.213.0",
    "@opentelemetry/instrumentation-pino": "^0.59.0",
    "@opentelemetry/resources": "^2.6.0",
    "@opentelemetry/sdk-node": "^0.213.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@types/react": "^19.2.14",
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.0",
    "ink": "^6.7.0",
    "ink-gradient": "^4.0.0",
    "ink-spinner": "^5.0.0",
    "jsonrepair": "^3.13.2",
    "mcp-thinkgate": "^0.1.0",
    "node-telegram-bot-api": "^0.67.0",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.4",
    "supermemory": "^4.11.1",
    "whatsapp-web.js": "^1.34.6"
  },
  "devDependencies": {
    "@types/node": "^25.2.2",
    "@types/node-telegram-bot-api": "^0.64.13",
    "@types/qrcode-terminal": "^0.12.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
